# Wakes the options runner (Investing.com + Barchart) every 5 minutes; it only ASKS the app, which says "due" at most
# three times a day. Installed on the server 23 Nov 2026 with his permission; stop it: systemctl disable --now bc.timer
[Unit]
Description=Ask the app whether a Barchart options fetch is due

[Timer]
OnBootSec=4min
OnUnitActiveSec=5min
RandomizedDelaySec=30
AccuracySec=30s
Unit=bc.service

[Install]
WantedBy=timers.target
