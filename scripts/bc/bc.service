# One run of the Barchart options fetcher. Started by bc.timer; never enabled on its own.
# Type=oneshot with NO Restart=: a refusal means waiting (the app's job), never asking again harder.
[Unit]
Description=Fetch Barchart futures-options Greeks & volatility (one run)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/bc/run.sh
# Just over run.sh's own 1200 s kill (Investing.com + Barchart's three markets with pauses). It was 420 s — every full
# run would have been killed half-way (found 23 Nov 2026, before the first install).
TimeoutStartSec=1300
WorkingDirectory=/opt/bc
StandardOutput=append:/var/log/bc.log
StandardError=append:/var/log/bc.log
